generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum BusinessType {
  PHARMACY
  GROCERY
  ELECTRONICS
  CLOTHING
  WHOLESALE
  GENERAL_RETAIL
  OTHER
}

enum BusinessAccountStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
  TEMPORARILY_BLOCKED
  EXPIRED
  DELETED
}

enum NotificationAudience {
  PLATFORM_ADMIN
  BUSINESS_USER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

model User {
  id                  String                   @id @default(cuid())
  name                String?
  email               String                   @unique @db.VarChar(191)
  emailVerified       DateTime?
  image               String?                  @db.Text
  passwordHash        String?                  @db.VarChar(255)
  platformRole        PlatformRole             @default(USER)
  tokenVersion        Int                      @default(0)
  disabledAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  memberships         Membership[]
  sentInvitations     MembershipInvite[]       @relation("InvitationSender")
  emailTokens         EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  managedBranches     Branch[]                 @relation("BranchManager")
  auditEvents         AuditLog[]
  approvedBusinesses  Business[]               @relation("BusinessApprover")
  statusChanges       BusinessStatusHistory[]  @relation("BusinessStatusActor")
  notifications       Notification[]
  stockMovements      StockMovement[]

  @@index([platformRole, disabledAt])
  @@index([deletedAt, disabledAt])
  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Business {
  id                    String                  @id @default(cuid())
  name                  String                  @db.VarChar(191)
  slug                  String                  @unique @db.VarChar(191)
  type                  BusinessType            @default(GENERAL_RETAIL)
  description           String?                 @db.Text
  logoUrl               String?                 @db.Text
  email                 String?                 @db.VarChar(191)
  phone                 String?                 @db.VarChar(40)
  address               String?                 @db.Text
  latitude              Decimal?                @db.Decimal(10, 7)
  longitude             Decimal?                @db.Decimal(10, 7)
  businessHours         Json?
  taxId                 String?                 @db.VarChar(100)
  currency              String                  @default("USD") @db.Char(3)
  timezone              String                  @default("UTC") @db.VarChar(64)
  website               String?                 @db.VarChar(255)
  accountStatus         BusinessAccountStatus   @default(PENDING_APPROVAL)
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  statusReason          String?                 @db.VarChar(500)
  statusUntil           DateTime?
  approvedById          String?
  rejectionReason       String?                 @db.VarChar(1000)
  statusBeforeDeletion  BusinessAccountStatus?
  statusChangedAt       DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  approvedBy            User?                   @relation("BusinessApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  memberships           Membership[]
  invitations           MembershipInvite[]
  roles                 Role[]
  products              Product[]
  categories            Category[]
  productListings       ProductListing[]
  stockMovements        StockMovement[]
  customers             Customer[]
  suppliers             Supplier[]
  purchases             Purchase[]
  sales                 Sale[]
  expenses              Expense[]
  branches              Branch[]
  warehouses            Warehouse[]
  auditLogs             AuditLog[]
  statusHistory         BusinessStatusHistory[]
  notifications         Notification[]

  @@index([type, accountStatus, deletedAt])
  @@index([accountStatus, subscriptionExpiresAt, deletedAt])
  @@index([statusUntil, accountStatus])
  @@map("businesses")
}

model Membership {
  id         String           @id @default(cuid())
  businessId String
  userId     String
  roleId     String
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, status])
  @@map("memberships")
}

model Role {
  id          String             @id @default(cuid())
  businessId  String
  name        String             @db.VarChar(100)
  key         String             @db.VarChar(64)
  description String?            @db.VarChar(255)
  isSystem    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations MembershipInvite[]
  permissions RolePermission[]

  @@unique([businessId, key])
  @@unique([id, businessId])
  @@index([businessId, isSystem])
  @@map("roles")
}

model Permission {
  key         String           @id @db.VarChar(100)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String
  permissionKey String     @db.VarChar(100)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model MembershipInvite {
  id          String    @id @default(cuid())
  businessId  String
  roleId      String
  invitedById String
  email       String    @db.VarChar(191)
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId, businessId], references: [id, businessId], onDelete: Restrict)
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([businessId, expiresAt])
  @@index([businessId, email, acceptedAt])
  @@index([email, expiresAt])
  @@map("membership_invites")
}

model Branch {
  id              String           @id @default(cuid())
  businessId      String
  name            String           @db.VarChar(191)
  code            String           @db.VarChar(32)
  managerId       String?
  phone           String?          @db.VarChar(40)
  address         String?          @db.Text
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  businessHours   Json?
  status          BranchStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager         User?            @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  productListings ProductListing[]
  warehouses      Warehouse[]
  purchases       Purchase[]
  sales           Sale[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status, deletedAt])
  @@index([managerId])
  @@map("branches")
}

model Product {
  id          String           @id @default(cuid())
  businessId  String
  name        String           @db.VarChar(191)
  sku         String           @db.VarChar(64)
  barcode     String?          @db.VarChar(128)
  brand       String?          @db.VarChar(120)
  category    String?          @db.VarChar(120)
  categoryId  String?
  description String?          @db.Text
  imageUrl    String?          @db.Text
  unit        String           @default("unit") @db.VarChar(32)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryRef Category?        @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  listings    ProductListing[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@unique([id, businessId])
  @@index([businessId, name, deletedAt])
  @@index([businessId, category, deletedAt])
  @@index([businessId, categoryId, deletedAt])
  @@map("products")
}

model Category {
  id          String    @id @default(cuid())
  businessId  String
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@index([businessId, deletedAt, name])
  @@map("categories")
}

model ProductListing {
  id                 String           @id @default(cuid())
  businessId         String
  productId          String
  branchId           String
  price              Decimal          @db.Decimal(12, 2)
  marketplaceEnabled Boolean          @default(false)
  pickupEnabled      Boolean          @default(true)
  deliveryEnabled    Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)
  branch             Branch           @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)
  batches            InventoryBatch[]
  stockMovements     StockMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]

  @@unique([productId, branchId])
  @@unique([id, businessId])
  @@index([businessId, marketplaceEnabled, branchId])
  @@index([productId, marketplaceEnabled])
  @@map("product_listings")
}

model InventoryBatch {
  id                String          @id @default(cuid())
  businessId        String
  productListingId  String
  batchNumber       String          @db.VarChar(64)
  quantityRemaining Decimal         @db.Decimal(14, 3)
  expiryDate        DateTime?
  receivedAt        DateTime        @default(now())
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  listing           ProductListing  @relation(fields: [productListingId, businessId], references: [id, businessId], onDelete: Cascade)
  movements         StockMovement[]

  @@unique([productListingId, batchNumber])
  @@unique([id, businessId])
  @@index([businessId, productListingId, expiryDate, archivedAt])
  @@index([productListingId, quantityRemaining, expiryDate])
  @@map("inventory_batches")
}

model StockMovement {
  id               String            @id @default(cuid())
  businessId       String
  productListingId String
  inventoryBatchId String?
  actorId          String?
  type             StockMovementType
  quantityChange   Decimal           @db.Decimal(14, 3)
  unitCost         Decimal?          @db.Decimal(12, 2)
  reference        String?           @db.VarChar(191)
  note             String?           @db.VarChar(500)
  createdAt        DateTime          @default(now())
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing          ProductListing    @relation(fields: [productListingId, businessId], references: [id, businessId], onDelete: Cascade)
  batch            InventoryBatch?   @relation(fields: [inventoryBatchId, businessId], references: [id, businessId], onDelete: Restrict)
  actor            User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([productListingId, createdAt])
  @@index([businessId, type, createdAt])
  @@map("stock_movements")
}

model Customer {
  id         String    @id @default(cuid())
  businessId String
  name       String    @db.VarChar(191)
  email      String?   @db.VarChar(191)
  phone      String?   @db.VarChar(40)
  address    String?   @db.Text
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales      Sale[]

  @@unique([id, businessId])
  @@index([businessId, name, deletedAt])
  @@index([businessId, email])
  @@map("customers")
}

model Supplier {
  id         String     @id @default(cuid())
  businessId String
  name       String     @db.VarChar(191)
  email      String?    @db.VarChar(191)
  phone      String?    @db.VarChar(40)
  address    String?    @db.Text
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases  Purchase[]

  @@unique([id, businessId])
  @@index([businessId, name, deletedAt])
  @@index([businessId, email])
  @@map("suppliers")
}

model Purchase {
  id          String         @id @default(cuid())
  businessId  String
  branchId    String
  supplierId  String?
  reference   String         @db.VarChar(64)
  notes       String?        @db.VarChar(1000)
  total       Decimal        @db.Decimal(14, 2)
  purchasedAt DateTime       @default(now())
  createdById String?
  createdAt   DateTime       @default(now())
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch         @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier    Supplier?      @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  items       PurchaseItem[]

  @@unique([businessId, reference])
  @@unique([id, businessId])
  @@index([businessId, purchasedAt])
  @@index([businessId, supplierId, purchasedAt])
  @@map("purchases")
}

model PurchaseItem {
  id               String         @id @default(cuid())
  businessId       String
  purchaseId       String
  productListingId String
  quantity         Decimal        @db.Decimal(14, 3)
  unitCost         Decimal        @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(14, 2)
  batchNumber      String         @db.VarChar(64)
  expiryDate       DateTime?
  purchase         Purchase       @relation(fields: [purchaseId, businessId], references: [id, businessId], onDelete: Cascade)
  listing          ProductListing @relation(fields: [productListingId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, purchaseId])
  @@map("purchase_items")
}

model Sale {
  id          String     @id @default(cuid())
  businessId  String
  branchId    String
  customerId  String?
  reference   String     @db.VarChar(64)
  notes       String?    @db.VarChar(1000)
  total       Decimal    @db.Decimal(14, 2)
  soldAt      DateTime   @default(now())
  createdById String?
  createdAt   DateTime   @default(now())
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch     @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  customer    Customer?  @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  items       SaleItem[]

  @@unique([businessId, reference])
  @@unique([id, businessId])
  @@index([businessId, soldAt])
  @@index([businessId, customerId, soldAt])
  @@map("sales")
}

model SaleItem {
  id               String         @id @default(cuid())
  businessId       String
  saleId           String
  productListingId String
  quantity         Decimal        @db.Decimal(14, 3)
  unitPrice        Decimal        @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(14, 2)
  sale             Sale           @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Cascade)
  listing          ProductListing @relation(fields: [productListingId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, saleId])
  @@map("sale_items")
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  title       String   @db.VarChar(191)
  category    String   @db.VarChar(120)
  amount      Decimal  @db.Decimal(14, 2)
  notes       String?  @db.VarChar(1000)
  incurredAt  DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, incurredAt])
  @@index([businessId, category, incurredAt])
  @@map("expenses")
}

model Warehouse {
  id         String    @id @default(cuid())
  businessId String
  branchId   String
  name       String    @db.VarChar(191)
  code       String    @db.VarChar(32)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch    @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([branchId, code])
  @@index([businessId, branchId, deletedAt])
  @@map("warehouses")
}

model AuditLog {
  id         String    @id @default(cuid())
  businessId String?
  userId     String?
  action     String    @db.VarChar(100)
  entity     String    @db.VarChar(100)
  entityId   String?   @db.VarChar(191)
  metadata   Json?
  ipAddress  String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model BusinessStatusHistory {
  id             String                 @id @default(cuid())
  businessId     String?
  businessName   String                 @db.VarChar(191)
  actorId        String?
  previousStatus BusinessAccountStatus?
  newStatus      BusinessAccountStatus
  reason         String?                @db.VarChar(1000)
  metadata       Json?
  createdAt      DateTime               @default(now())
  business       Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor          User?                  @relation("BusinessStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@index([newStatus, createdAt])
  @@map("business_status_history")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String?
  businessId String?
  audience   NotificationAudience
  type       String               @db.VarChar(64)
  title      String               @db.VarChar(191)
  body       String               @db.Text
  dedupeKey  String?              @unique @db.VarChar(191)
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  business   Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([audience, userId, readAt, createdAt])
  @@index([businessId, createdAt])
  @@map("notifications")
}

model PlatformSettings {
  id                  String   @id @default("default") @db.VarChar(64)
  defaultAccessMonths Int      @default(1)
  expiryWarningDays   Int      @default(7)
  updatedAt           DateTime @updatedAt

  @@map("platform_settings")
}
