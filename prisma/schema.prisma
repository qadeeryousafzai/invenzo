generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum BusinessType {
  PHARMACY
  GROCERY
  ELECTRONICS
  CLOTHING
  WHOLESALE
  GENERAL_RETAIL
  OTHER
}

enum BusinessAccountStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
  TEMPORARILY_BLOCKED
  EXPIRED
  DELETED
}

enum NotificationAudience {
  PLATFORM_ADMIN
  BUSINESS_USER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

model User {
  id                         String                   @id @default(cuid())
  name                       String?
  email                      String                   @unique @db.VarChar(191)
  emailVerified              DateTime?
  image                      String?                  @db.Text
  passwordHash               String?                  @db.VarChar(255)
  platformRole               PlatformRole             @default(USER)
  tokenVersion               Int                      @default(0)
  disabledAt                 DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  memberships                Membership[]
  sentInvitations            MembershipInvite[]       @relation("InvitationSender")
  emailTokens                EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  managedBranches            Branch[]                 @relation("BranchManager")
  auditEvents                AuditLog[]
  approvedBusinesses         Business[]               @relation("BusinessApprover")
  statusChanges              BusinessStatusHistory[]  @relation("BusinessStatusActor")
  notifications              Notification[]
  stockMovements             StockMovement[]
  dispensedPrescriptionItems PrescriptionItem[]

  @@index([platformRole, disabledAt])
  @@index([deletedAt, disabledAt])
  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Business {
  id                    String                  @id @default(cuid())
  name                  String                  @db.VarChar(191)
  slug                  String                  @unique @db.VarChar(191)
  type                  BusinessType            @default(GENERAL_RETAIL)
  description           String?                 @db.Text
  logoUrl               String?                 @db.Text
  email                 String?                 @db.VarChar(191)
  phone                 String?                 @db.VarChar(40)
  address               String?                 @db.Text
  latitude              Decimal?                @db.Decimal(10, 7)
  longitude             Decimal?                @db.Decimal(10, 7)
  businessHours         Json?
  taxId                 String?                 @db.VarChar(100)
  currency              String                  @default("USD") @db.Char(3)
  timezone              String                  @default("UTC") @db.VarChar(64)
  website               String?                 @db.VarChar(255)
  accountStatus         BusinessAccountStatus   @default(PENDING_APPROVAL)
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  statusReason          String?                 @db.VarChar(500)
  statusUntil           DateTime?
  approvedById          String?
  rejectionReason       String?                 @db.VarChar(1000)
  statusBeforeDeletion  BusinessAccountStatus?
  statusChangedAt       DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  approvedBy            User?                   @relation("BusinessApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  memberships           Membership[]
  invitations           MembershipInvite[]
  roles                 Role[]
  products              Product[]
  categories            Category[]
  productListings       ProductListing[]
  stockMovements        StockMovement[]
  customers             Customer[]
  suppliers             Supplier[]
  purchases             Purchase[]
  sales                 Sale[]
  expenses              Expense[]
  incomes               Income[]
  branches              Branch[]
  warehouses            Warehouse[]
  auditLogs             AuditLog[]
  statusHistory         BusinessStatusHistory[]
  notifications         Notification[]
  doctors               Doctor[]
  departments           Department[]
  services              Service[]
  patients              Patient[]
  appointments          Appointment[]
  prescriptions         Prescription[]
  admissions            Admission[]
  beds                  Bed[]

  @@index([type, accountStatus, deletedAt])
  @@index([accountStatus, subscriptionExpiresAt, deletedAt])
  @@index([statusUntil, accountStatus])
  @@map("businesses")
}

model Membership {
  id         String           @id @default(cuid())
  businessId String
  userId     String
  roleId     String
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, status])
  @@map("memberships")
}

model Role {
  id          String             @id @default(cuid())
  businessId  String
  name        String             @db.VarChar(100)
  key         String             @db.VarChar(64)
  description String?            @db.VarChar(255)
  isSystem    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations MembershipInvite[]
  permissions RolePermission[]

  @@unique([businessId, key])
  @@unique([id, businessId])
  @@index([businessId, isSystem])
  @@map("roles")
}

model Permission {
  key         String           @id @db.VarChar(100)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String
  permissionKey String     @db.VarChar(100)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model MembershipInvite {
  id          String    @id @default(cuid())
  businessId  String
  roleId      String
  invitedById String
  email       String    @db.VarChar(191)
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId, businessId], references: [id, businessId], onDelete: Restrict)
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([businessId, expiresAt])
  @@index([businessId, email, acceptedAt])
  @@index([email, expiresAt])
  @@map("membership_invites")
}

model Branch {
  id              String           @id @default(cuid())
  businessId      String
  name            String           @db.VarChar(191)
  code            String           @db.VarChar(32)
  managerId       String?
  phone           String?          @db.VarChar(40)
  address         String?          @db.Text
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  businessHours   Json?
  status          BranchStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager         User?            @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  productListings ProductListing[]
  warehouses      Warehouse[]
  purchases       Purchase[]
  sales           Sale[]
  beds            Bed[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status, deletedAt])
  @@index([managerId])
  @@map("branches")
}

model Product {
  id                String           @id @default(cuid())
  businessId        String
  name              String           @db.VarChar(191)
  sku               String           @db.VarChar(64)
  barcode           String?          @db.VarChar(128)
  brand             String?          @db.VarChar(120)
  category          String?          @db.VarChar(120)
  categoryId        String?
  description       String?          @db.Text
  imageUrl          String?          @db.Text
  unit              String           @default("unit") @db.VarChar(32)
  /**
   * Base units contained in one sellable pack (e.g. 10 tablets per box). 1 = sold as single units.
   */
  packSize          Int              @default(1)
  /**
   * Pack label shown in the POS, e.g. "Box" or "Strip".
   */
  packUnit          String?          @db.VarChar(32)
  catalogMedicineId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryRef       Category?        @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  catalogMedicine   Medicine?        @relation(fields: [catalogMedicineId], references: [id], onDelete: SetNull)
  listings          ProductListing[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@unique([id, businessId])
  @@index([businessId, name, deletedAt])
  @@index([businessId, category, deletedAt])
  @@index([businessId, categoryId, deletedAt])
  @@index([catalogMedicineId])
  @@map("products")
}

model Category {
  id          String    @id @default(cuid())
  businessId  String
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@index([businessId, deletedAt, name])
  @@map("categories")
}

model ProductListing {
  id                 String             @id @default(cuid())
  businessId         String
  productId          String
  branchId           String
  price              Decimal            @db.Decimal(12, 2)
  marketplaceEnabled Boolean            @default(false)
  pickupEnabled      Boolean            @default(true)
  deliveryEnabled    Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)
  branch             Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)
  batches            InventoryBatch[]
  stockMovements     StockMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  prescriptionItems  PrescriptionItem[]

  @@unique([productId, branchId])
  @@unique([id, businessId])
  @@index([businessId, marketplaceEnabled, branchId])
  @@index([productId, marketplaceEnabled])
  @@map("product_listings")
}

model InventoryBatch {
  id                String          @id @default(cuid())
  businessId        String
  productListingId  String
  batchNumber       String          @db.VarChar(64)
  quantityRemaining Decimal         @db.Decimal(14, 3)
  expiryDate        DateTime?
  receivedAt        DateTime        @default(now())
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  listing           ProductListing  @relation(fields: [productListingId, businessId], references: [id, businessId], onDelete: Cascade)
  movements         StockMovement[]

  @@unique([productListingId, batchNumber])
  @@unique([id, businessId])
  @@index([businessId, productListingId, expiryDate, archivedAt])
  @@index([productListingId, quantityRemaining, expiryDate])
  @@map("inventory_batches")
}

model StockMovement {
  id               String            @id @default(cuid())
  businessId       String
  productListingId String
  inventoryBatchId String?
  actorId          String?
  type             StockMovementType
  quantityChange   Decimal           @db.Decimal(14, 3)
  unitCost         Decimal?          @db.Decimal(12, 2)
  reference        String?           @db.VarChar(191)
  note             String?           @db.VarChar(500)
  createdAt        DateTime          @default(now())
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing          ProductListing    @relation(fields: [productListingId, businessId], references: [id, businessId], onDelete: Cascade)
  batch            InventoryBatch?   @relation(fields: [inventoryBatchId, businessId], references: [id, businessId], onDelete: Restrict)
  actor            User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([productListingId, createdAt])
  @@index([businessId, type, createdAt])
  @@map("stock_movements")
}

model Customer {
  id         String    @id @default(cuid())
  businessId String
  name       String    @db.VarChar(191)
  email      String?   @db.VarChar(191)
  phone      String?   @db.VarChar(40)
  address    String?   @db.Text
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales      Sale[]

  @@unique([id, businessId])
  @@index([businessId, name, deletedAt])
  @@index([businessId, email])
  @@map("customers")
}

model Supplier {
  id         String     @id @default(cuid())
  businessId String
  name       String     @db.VarChar(191)
  email      String?    @db.VarChar(191)
  phone      String?    @db.VarChar(40)
  address    String?    @db.Text
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases  Purchase[]

  @@unique([id, businessId])
  @@index([businessId, name, deletedAt])
  @@index([businessId, email])
  @@map("suppliers")
}

model Purchase {
  id          String         @id @default(cuid())
  businessId  String
  branchId    String
  supplierId  String?
  reference   String         @db.VarChar(64)
  notes       String?        @db.VarChar(1000)
  total       Decimal        @db.Decimal(14, 2)
  purchasedAt DateTime       @default(now())
  createdById String?
  createdAt   DateTime       @default(now())
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch         @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier    Supplier?      @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  items       PurchaseItem[]

  @@unique([businessId, reference])
  @@unique([id, businessId])
  @@index([businessId, purchasedAt])
  @@index([businessId, supplierId, purchasedAt])
  @@map("purchases")
}

model PurchaseItem {
  id               String         @id @default(cuid())
  businessId       String
  purchaseId       String
  productListingId String
  quantity         Decimal        @db.Decimal(14, 3)
  unitCost         Decimal        @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(14, 2)
  batchNumber      String         @db.VarChar(64)
  expiryDate       DateTime?
  purchase         Purchase       @relation(fields: [purchaseId, businessId], references: [id, businessId], onDelete: Cascade)
  listing          ProductListing @relation(fields: [productListingId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, purchaseId])
  @@map("purchase_items")
}

model Sale {
  id          String     @id @default(cuid())
  businessId  String
  branchId    String
  customerId  String?
  reference   String     @db.VarChar(64)
  notes       String?    @db.VarChar(1000)
  total       Decimal    @db.Decimal(14, 2)
  soldAt      DateTime   @default(now())
  createdById String?
  createdAt   DateTime   @default(now())
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch     @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  customer    Customer?  @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  items       SaleItem[]

  @@unique([businessId, reference])
  @@unique([id, businessId])
  @@index([businessId, soldAt])
  @@index([businessId, customerId, soldAt])
  @@map("sales")
}

model SaleItem {
  id               String         @id @default(cuid())
  businessId       String
  saleId           String
  productListingId String
  quantity         Decimal        @db.Decimal(14, 3)
  unitPrice        Decimal        @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(14, 2)
  sale             Sale           @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Cascade)
  listing          ProductListing @relation(fields: [productListingId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, saleId])
  @@map("sale_items")
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  title       String   @db.VarChar(191)
  category    String   @db.VarChar(120)
  amount      Decimal  @db.Decimal(14, 2)
  notes       String?  @db.VarChar(1000)
  incurredAt  DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, incurredAt])
  @@index([businessId, category, incurredAt])
  @@map("expenses")
}

model Warehouse {
  id         String    @id @default(cuid())
  businessId String
  branchId   String
  name       String    @db.VarChar(191)
  code       String    @db.VarChar(32)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch    @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([branchId, code])
  @@index([businessId, branchId, deletedAt])
  @@map("warehouses")
}

model AuditLog {
  id         String    @id @default(cuid())
  businessId String?
  userId     String?
  action     String    @db.VarChar(100)
  entity     String    @db.VarChar(100)
  entityId   String?   @db.VarChar(191)
  metadata   Json?
  ipAddress  String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model BusinessStatusHistory {
  id             String                 @id @default(cuid())
  businessId     String?
  businessName   String                 @db.VarChar(191)
  actorId        String?
  previousStatus BusinessAccountStatus?
  newStatus      BusinessAccountStatus
  reason         String?                @db.VarChar(1000)
  metadata       Json?
  createdAt      DateTime               @default(now())
  business       Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor          User?                  @relation("BusinessStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@index([newStatus, createdAt])
  @@map("business_status_history")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String?
  businessId String?
  audience   NotificationAudience
  type       String               @db.VarChar(64)
  title      String               @db.VarChar(191)
  body       String               @db.Text
  dedupeKey  String?              @unique @db.VarChar(191)
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  business   Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([audience, userId, readAt, createdAt])
  @@index([businessId, createdAt])
  @@map("notifications")
}

model PlatformSettings {
  id                  String   @id @default("default") @db.VarChar(64)
  defaultAccessMonths Int      @default(1)
  expiryWarningDays   Int      @default(7)
  updatedAt           DateTime @updatedAt

  @@map("platform_settings")
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
  EXPIRED
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

enum BedType {
  GENERAL
  PRIVATE
  SEMI_PRIVATE
  ICU
  EMERGENCY
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model Doctor {
  id              String         @id @default(cuid())
  businessId      String
  name            String         @db.VarChar(191)
  specialty       String         @db.VarChar(120)
  phone           String?        @db.VarChar(40)
  email           String?        @db.VarChar(191)
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  consultationFee Decimal?       @db.Decimal(10, 2)
  status          String         @default("ACTIVE") @db.VarChar(32)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  prescriptions   Prescription[]
  admissions      Admission[]

  @@unique([id, businessId])
  @@index([businessId, deletedAt, status])
  @@index([businessId, specialty])
  @@map("doctors")
}

model Department {
  id           String        @id @default(cuid())
  businessId   String
  name         String        @db.VarChar(120)
  description  String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  doctors      Doctor[]
  services     Service[]
  beds         Bed[]
  appointments Appointment[]
  admissions   Admission[]

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@index([businessId, deletedAt])
  @@map("departments")
}

model Service {
  id           String      @id @default(cuid())
  businessId   String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String      @db.VarChar(191)
  description  String?     @db.Text
  price        Decimal?    @db.Decimal(10, 2)
  duration     Int?        @default(30)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@index([businessId, deletedAt])
  @@map("services")
}

model Patient {
  id               String         @id @default(cuid())
  businessId       String
  patientId        String         @unique @db.VarChar(32)
  firstName        String         @db.VarChar(100)
  lastName         String         @db.VarChar(100)
  dateOfBirth      DateTime?
  gender           PatientGender? @default(OTHER)
  phone            String?        @db.VarChar(40)
  email            String?        @db.VarChar(191)
  address          String?        @db.Text
  emergencyContact String?        @db.VarChar(191)
  emergencyPhone   String?        @db.VarChar(40)
  allergies        String?        @db.Text
  medicalHistory   String?        @db.Text
  bloodType        String?        @db.VarChar(10)
  status           String         @default("ACTIVE") @db.VarChar(32)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  prescriptions    Prescription[]
  admissions       Admission[]
  beds             Bed[]

  @@unique([id, businessId])
  @@index([businessId, deletedAt])
  @@index([businessId, patientId])
  @@index([businessId, phone])
  @@map("patients")
}

model Appointment {
  id              String            @id @default(cuid())
  businessId      String
  appointmentId   String            @unique @db.VarChar(32)
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId        String?
  doctor          Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointmentDate DateTime
  appointmentTime String            @db.VarChar(10)
  reason          String?           @db.Text
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     String?
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId, appointmentDate])
  @@index([businessId, patientId, appointmentDate])
  @@index([businessId, doctorId, appointmentDate])
  @@index([businessId, status])
  @@map("appointments")
}

model Prescription {
  id               String             @id @default(cuid())
  businessId       String
  prescriptionId   String             @unique @db.VarChar(32)
  patientId        String
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId         String?
  doctor           Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  prescriptionDate DateTime           @default(now())
  status           PrescriptionStatus @default(ACTIVE)
  notes            String?            @db.Text
  instructions     String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items            PrescriptionItem[]

  @@unique([id, businessId])
  @@index([businessId, patientId])
  @@index([businessId, doctorId])
  @@index([businessId, status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                String         @id @default(cuid())
  businessId        String
  prescriptionId    String
  prescription      Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  productListingId  String
  listing           ProductListing @relation(fields: [productListingId], references: [id], onDelete: Restrict)
  dosage            String         @db.VarChar(100)
  frequency         String         @db.VarChar(100)
  duration          String         @db.VarChar(100)
  quantity          Decimal        @db.Decimal(10, 2)
  dispensedQuantity Decimal        @default(0) @db.Decimal(10, 2)
  instructions      String?        @db.Text
  dispensedAt       DateTime?
  dispensedById     String?
  dispensedBy       User?          @relation(fields: [dispensedById], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())

  @@unique([id, businessId])
  @@index([businessId, prescriptionId])
  @@map("prescription_items")
}

model Admission {
  id              String          @id @default(cuid())
  businessId      String
  admissionId     String          @unique @db.VarChar(32)
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId        String?
  doctor          Doctor?         @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  bedId           String?
  bed             Bed?            @relation(fields: [bedId], references: [id], onDelete: SetNull)
  admissionDate   DateTime        @default(now())
  dischargeDate   DateTime?
  admissionReason String?         @db.Text
  dischargeReason String?         @db.Text
  status          AdmissionStatus @default(ADMITTED)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId, patientId])
  @@index([businessId, bedId])
  @@index([businessId, status])
  @@map("admissions")
}

model Bed {
  id           String      @id @default(cuid())
  businessId   String
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  bedNumber    String      @db.VarChar(32)
  bedType      BedType     @default(GENERAL)
  status       BedStatus   @default(AVAILABLE)
  patientId    String?
  patient      Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  admissions   Admission[]

  @@unique([businessId, bedNumber])
  @@unique([id, businessId])
  @@index([businessId, departmentId, status])
  @@index([businessId, branchId])
  @@map("beds")
}

model Income {
  id            String   @id @default(cuid())
  businessId    String
  title         String   @db.VarChar(191)
  category      String   @db.VarChar(120)
  amount        Decimal  @db.Decimal(14, 2)
  date          DateTime @default(now())
  paymentMethod String?  @db.VarChar(50)
  reference     String?  @db.VarChar(191)
  notes         String?  @db.Text
  createdById   String?
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
  @@index([businessId, category, date])
  @@map("incomes")
}

/// Global Medicine Catalog — shared, read-only reference data imported from
/// authoritative public datasets. Tenant pharmacies reference catalog rows but
/// never write to them; pharmacy-specific stock/pricing stays in Product.
model MedicineSource {
  id                    String    @id @default(cuid())
  key                   String    @unique @db.VarChar(64)
  name                  String    @db.VarChar(191)
  countryCode           String?   @db.Char(2)
  countryName           String?   @db.VarChar(120)
  homepageUrl           String?   @db.VarChar(500)
  datasetUrl            String?   @db.VarChar(1000)
  licenseName           String?   @db.VarChar(191)
  licenseUrl            String?   @db.VarChar(1000)
  attributionRequired   Boolean   @default(false)
  redistributionAllowed Boolean   @default(false)
  commercialUseAllowed  Boolean   @default(false)
  termsReviewedAt       DateTime?
  adapterKey            String?   @db.VarChar(64)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  medicines             Medicine[]
  sourceRecords         MedicineSourceRecord[]
  importJobs            MedicineImportJob[]
  medicineManufacturers MedicineManufacturer[]

  @@index([countryCode])
  @@map("medicine_sources")
}

model MedicineCategory {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  parentId    String?
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  parent    MedicineCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MedicineCategory[] @relation("CategoryTree")
  medicines Medicine[]

  @@index([parentId])
  @@map("medicine_categories")
}

model MedicineManufacturer {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(191)
  name        String   @db.VarChar(191)
  countryCode String?  @db.Char(2)
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  source    MedicineSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  medicines Medicine[]

  @@index([name])
  @@index([countryCode])
  @@index([sourceId])
  @@map("medicine_manufacturers")
}

model Medicine {
  id               String   @id @default(cuid())
  canonicalKey     String   @unique @db.VarChar(191)
  sourceId         String
  sourceRecordId   String   @db.VarChar(191)
  brandName        String?  @db.VarChar(191)
  genericName      String?  @db.VarChar(191)
  displayName      String   @db.VarChar(191)
  nameNormalized   String   @db.VarChar(191)
  searchText       String?  @db.Text
  strengthText     String?  @db.VarChar(191)
  dosageForm       String?  @db.VarChar(120)
  route            String?  @db.VarChar(120)
  atcCode          String?  @db.VarChar(32)
  manufacturerId   String?
  categoryId       String?
  countryCode      String?  @db.Char(2)
  regulatoryStatus String?  @db.VarChar(64)
  isBrand          Boolean  @default(false)
  isGeneric        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  source        MedicineSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  manufacturer  MedicineManufacturer?  @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  category      MedicineCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients   MedicineIngredient[]
  identifiers   MedicineIdentifier[]
  packages      MedicinePackage[]
  aliases       MedicineAlias[]
  sourceRecords MedicineSourceRecord[]
  products      Product[]

  @@index([sourceId, sourceRecordId])
  @@index([genericName])
  @@index([brandName])
  @@index([displayName])
  @@index([nameNormalized])
  @@index([strengthText])
  @@index([dosageForm])
  @@index([atcCode])
  @@index([manufacturerId])
  @@index([categoryId])
  @@index([countryCode])
  @@index([isBrand])
  @@index([isGeneric])
  @@fulltext([searchText])
  @@map("medicines")
}

model MedicineIngredient {
  id           String   @id @default(cuid())
  medicineId   String
  name         String   @db.VarChar(191)
  role         String?  @db.VarChar(64)
  strengthText String?  @db.VarChar(191)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
  @@index([name])
  @@map("medicine_ingredients")
}

model MedicineIdentifier {
  id         String   @id @default(cuid())
  medicineId String
  system     String   @db.VarChar(120)
  value      String   @db.VarChar(191)
  use        String?  @db.VarChar(32)
  createdAt  DateTime @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
  @@index([system, value])
  @@index([value])
  @@map("medicine_identifiers")
}

model MedicinePackage {
  id               String   @id @default(cuid())
  medicineId       String
  description      String?  @db.VarChar(500)
  quantityValue    String?  @db.VarChar(64)
  quantityUnit     String?  @db.VarChar(64)
  gtin             String?  @db.VarChar(64)
  regulatoryStatus String?  @db.VarChar(64)
  marketingStatus  String?  @db.VarChar(64)
  sourceRecordId   String?  @db.VarChar(191)
  createdAt        DateTime @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
  @@index([gtin])
  @@map("medicine_packages")
}

model MedicineSourceRecord {
  id                    String    @id @default(cuid())
  sourceId              String
  sourceRecordId        String    @db.VarChar(191)
  medicineId            String?
  countryCode           String?   @db.Char(2)
  sourceUpdatedAt       DateTime?
  importedAt            DateTime  @default(now())
  licenseName           String?   @db.VarChar(191)
  licenseUrl            String?   @db.VarChar(1000)
  attributionRequired   Boolean   @default(false)
  redistributionAllowed Boolean   @default(false)
  commercialUseAllowed  Boolean   @default(false)
  rawKey                String?   @db.VarChar(191)
  notes                 String?   @db.Text

  source   MedicineSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  medicine Medicine?      @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@unique([sourceId, sourceRecordId])
  @@index([medicineId])
  @@index([sourceId])
  @@index([countryCode])
  @@map("medicine_source_records")
}

model MedicineAlias {
  id         String   @id @default(cuid())
  medicineId String
  alias      String   @db.VarChar(191)
  aliasType  String   @default("OTHER") @db.VarChar(32)
  sourceId   String?
  createdAt  DateTime @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
  @@index([alias])
  @@index([aliasType])
  @@map("medicine_aliases")
}

model MedicineImportJob {
  id               String    @id @default(cuid())
  sourceId         String
  status           String    @default("PENDING") @db.VarChar(24)
  datasetUrl       String?   @db.VarChar(1000)
  datasetLabel     String?   @db.VarChar(191)
  totalRecords     Int       @default(0)
  processedRecords Int       @default(0)
  importedRecords  Int       @default(0)
  duplicateRecords Int       @default(0)
  failedRecords    Int       @default(0)
  cursor           String?   @db.Text
  lastBatchSize    Int       @default(0)
  errorMessage     String?   @db.Text
  startedAt        DateTime?
  finishedAt       DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  source MedicineSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  errors MedicineImportError[]

  @@index([sourceId, status])
  @@index([status])
  @@index([createdAt])
  @@map("medicine_import_jobs")
}

model MedicineImportError {
  id             String   @id @default(cuid())
  jobId          String
  sourceRecordId String?  @db.VarChar(191)
  stage          String?  @db.VarChar(64)
  message        String   @db.Text
  details        Json?
  createdAt      DateTime @default(now())

  job MedicineImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([stage])
  @@map("medicine_import_errors")
}
